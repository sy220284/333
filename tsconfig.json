{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "src/*": [
        "./src/*"
      ],
      "audio-capture-napi": [
        "./native/audio-capture-src/index.ts"
      ],
      "image-processor-napi": [
        "./native/image-processor-src/index.ts"
      ],
      "modifiers-napi": [
        "./native/modifiers-napi-src/index.ts"
      ],
      "url-handler-napi": [
        "./native/url-handler-src/index.ts"
      ],
      "@ant/claude-for-chrome-mcp": [
        ".rebuild/deps/node_modules/@ant/claude-for-chrome-mcp/src/index.ts"
      ],
      "@ant/computer-use-mcp": [
        "./src/types/upstreamComputerUse/index.d.ts"
      ],
      "@ant/computer-use-mcp/types": [
        "./src/types/upstreamComputerUse/types.ts"
      ],
      "@ant/computer-use-input": [
        "./src/types/upstreamComputerUse/nativeInput.d.ts"
      ],
      "@ant/computer-use-swift": [
        "./src/types/upstreamComputerUse/nativeSwift.d.ts"
      ]
    },
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "allowImportingTsExtensions": true,
    "types": [
      "node",
      "react",
      "bun"
    ]
  },
  "include": [
    "src",
    "native"
  ],
  "exclude": [
    "src/skills/bundled/artifact-design/examples/**"
  ]
}
