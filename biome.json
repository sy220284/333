{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!research/**", "!dist/**", "!.rebuild/**", "!tools/dev/node_modules/**", "!node_modules/**"]
  },
  "formatter": { "enabled": true },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": { "useImportType": "off" }
    }
  }
}
